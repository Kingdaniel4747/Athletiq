# Optional configuration for AthletiQ.
# A local test works without this file: docker compose up -d

# Public address and ports
# "auto" follows the address opened in the browser (and reverse-proxy headers).
# Pin both values only when you deliberately want one canonical public domain.
RP_ID=auto
ORIGIN=auto
RP_NAME=AthletiQ
WEB_PORT=8080

# Accounts
ALLOW_GUEST=1
INVITE_ONLY=0
ADMIN_UIDS=
SESSION_DAYS=90

# Activity log
AUDIT_LOG=1
AUDIT_MAX=5000
AUDIT_DAYS=90
AUDIT_IP=off

# Push contact; blank uses the pinned HTTPS ORIGIN or a local mailto fallback
VAPID_SUBJECT=

# Open Food Facts identifies the requesting application with this value
FOOD_USER_AGENT="AthletiQ/1.0 (https://example.com)"

# Mealie (optional)
MEALIE_URL=
MEALIE_API_TOKEN=

# OpenAI-compatible coach endpoint (optional)
# Example for a model server on the Docker host:
# AI_API_URL=http://host.docker.internal:11434/v1/chat/completions
AI_API_URL=
AI_MODEL=
AI_API_KEY=

# For a real HTTPS deployment, replace at least:
# RP_ID=athletiq.example.com
# ORIGIN=https://athletiq.example.com
